# Calls OpenRouter directly. Add your key to .env.local (never commit it).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5
# Conservative context budget; keep at or below the selected model's limit.
OPENROUTER_CONTEXT_WINDOW=200000

# Optional CLI client settings:
EVE_URL=http://127.0.0.1:2000
# EVE_SESSION_ID=existing-session-id
# EVE_BEARER_TOKEN=authenticated-client-token
